{% extends 'site.twig' %}

{% block body_class %}max-w-7xl mx-auto font-sans px-4 sm:px-6 lg:px-8{% endblock %}

{% block main %}
    {{ hero.withClass('w-full h-96 object-cover mb-4') }}

    {% if this.page.image %}
        {{ this.page.image.withClass('w-full h-96 object-cover mb-4') }}
    {% endif %}
    <p>
        {{ this.page.content|raw }}
    </p>
{% endblock main %}

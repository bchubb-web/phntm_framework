{
    "name": "bchubbweb/phntm_framework",
    "description": "a basic framework build from symfony, with filesystem based routing",
    "type": "project",
    "license": "MIT",
    "version": "0.1.0",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Pages\\": "pages/"
        }
    },
    "authors": [
        {
            "name": "Billy Chubb",
            "email": "billy@bchubb.co.uk"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.4",
        "symfony/http-foundation": "^7.0",
        "spatie/image": "^3.8",
        "phntm-framework/phntm-lib": "dev-main"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/phntm-framework/phntm-lib"
        }
    ]
}
